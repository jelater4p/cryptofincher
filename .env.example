# ===== Helius (https://dashboard.helius.dev) =====
HELIUS_API_KEY=
# Free plan için düşük tutun; plan yükseltince artırın
HELIUS_RPS=8
HELIUS_MONTHLY_CREDITS=1000000
# Kredi maliyetleri (Helius panelindeki gerçek değerlere göre düzenleyin; varsayılanlar temkinli)
HELIUS_CREDIT_GET_SIGNATURES=10
HELIUS_CREDIT_GET_TRANSACTION=10

# ===== Jupiter (ücretsiz anahtar: https://portal.jup.ag) =====
JUPITER_API_KEY=
JUPITER_RPM=55

# ===== Telegram (@BotFather'dan token alın) =====
TELEGRAM_BOT_TOKEN=
# Botu kullanabilecek chat id'ler (virgülle). Bilmiyorsanız botu başlatıp /start yazın, size söyler.
TELEGRAM_ALLOWED_CHAT_IDS=

# ===== Motor =====
# paper | live (live için keystore gerekir)
TRADING_MODE=paper
PAPER_STARTING_SOL=10
# Agresif varsayılanlar: işlem başı özsermayenin %10'u, en fazla 15 açık pozisyon
RISK_PCT_PER_TRADE=10
RISK_MAX_OPEN_POSITIONS=15
RISK_MAX_SLIPPAGE_BPS=300
RISK_SOL_RESERVE=0.05
# Zorunlu güvenlik filtresi: RugCheck normalize skor üst sınırı (0-100, yüksek = riskli)
SAFETY_MAX_RUGCHECK_SCORE=50
SCAN_INTERVAL_SEC=20
POSITION_CHECK_INTERVAL_SEC=5
# Yeni pump.fun tokenlarını Helius WebSocket ile dinle (yüksek bant genişliği)
PUMPFUN_STREAM=false

# ===== Analiz =====
ANALYSIS_MAX_TX_PER_WALLET=250
ANALYSIS_MIN_CLOSED_POSITIONS=8
DISCOVERY_EARLY_BUYERS_PER_TOKEN=40
# 0 = kapalı. Örn 24: günde bir keşif → analiz → strateji çıkarımı.
# İlk keşif açılışta çalışır; yeniden başlatmalar ek keşif tetiklemez.
DISCOVERY_INTERVAL_HOURS=0
# Helius limiti dolunca Telegram'a kaç saatte bir hatırlatma gönderilsin
ALERT_REPEAT_HOURS=2
# Tarafsız token evreni: yeni açılan havuzları performanslarına bakmadan kaç dakikada bir kaydet (0 = kapalı)
UNIVERSE_RECORDER_MINUTES=5
UNIVERSE_RETENTION_DAYS=120
# Günlük özet saati (0-23, -1 = kapalı) ve saat dilimi
DAILY_SUMMARY_HOUR=9
SUMMARY_TIMEZONE=Europe/Istanbul

# ===== Depolama / anahtar =====
DATA_DIR=./data
KEYSTORE_PATH=./data/keystore.json
# Parolayı dosyadan okumak için (opsiyonel; boşsa başlangıçta sorulur)
# KEYSTORE_PASSPHRASE_FILE=/run/secrets/keystore_pass

LOG_LEVEL=info
