{
  "name": "cryptofincher",
  "version": "0.1.0",
  "description": "Solana kazanan cüzdan analizi, strateji çıkarımı ve alım-satım motoru",
  "type": "module",
  "private": true,
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "cli": "tsx src/cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@solana/web3.js": "1.98.4",
    "bs58": "6.0.0",
    "better-sqlite3": "12.11.1",
    "dotenv": "16.4.7",
    "grammy": "1.48.0",
    "pino": "9.6.0",
    "pino-pretty": "13.0.0",
    "ws": "8.18.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.12",
    "@types/node": "22.20.5",
    "@types/ws": "8.5.13",
    "tsx": "4.19.2",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
